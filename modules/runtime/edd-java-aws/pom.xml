<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.alphaprosoft</groupId>
        <artifactId>edd-java-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>edd-java-aws</artifactId>

    <name>edd-java-aws</name>
    <description>Lightweight CRaC/SnapStart Lambda runtime: SQS/S3 ingestion, effects to SQS.</description>

    <dependencies>
        <dependency>
            <groupId>com.alphaprosoft</groupId>
            <artifactId>edd-java-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-core</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-xray-recorder-sdk-core</artifactId>
            <version>2.18.2</version>
        </dependency>
        <!-- Compile (bundled, transitive), not provided: SqsRouter implements org.crac.Resource and the
             managed java25 Lambda runtime does not put org.crac on the function classpath, so every
             deployable built on this module must shade it in. -->
        <dependency>
            <groupId>org.crac</groupId>
            <artifactId>crac</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alphaprosoft</groupId>
            <artifactId>edd-event-store-memory</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.alphaprosoft</groupId>
            <artifactId>edd-view-store-memory</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
